{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(uv run pytest)",
      "Bash(uv run pytest:*)",
      "Bash(uv sync)",
      "Bash(uv add:*)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "python.analysis.autoImportCompletions": true,
  "python.analysis.fixAll": [
    "source.unusedImports"
  ],
  "editor.defaultFormatter": "black"
}